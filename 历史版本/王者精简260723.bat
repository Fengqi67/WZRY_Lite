:: 显示菜单
:show_menu
cls
echo ===================================
echo        王者荣耀精简(需Root权限)
echo ===================================
echo.
echo 可选项：
echo.
echo 1. 清空占位文件
echo 2. 开始精简

echo.
set /p "choice=请输入序号: "

:: 验证输入
set valid=0
if "!choice!"=="1" (
    set valid=1
    set selected_group=empty_files
    set selected_name=清空占位文件
) else if "!choice!"=="2" (
    set valid=1
    set selected_group=all_groups
    set selected_name=全部组别
) else (
    echo 无效的编号！
    pause
    goto show_menu
)

:: 执行操作
:process
cls
if "!selected_group!"=="empty_files" goto empty_files_action
if "!selected_group!"=="all_groups" goto all_groups_action
goto show_menu

:empty_files_action
echo ===================================
echo        查找占位文件
echo ===================================
echo.

echo 正在扫描占位文件...
echo.
adb shell "su -c 'ls -la "%target_dir%" 2>/dev/null | grep -E \"^-r--\"'" > placeholder_list.txt
adb shell "su -c 'find "%target_dir%" -type f -size 0 2>/dev/null'" >> placeholder_list.txt 
type placeholder_list.txt

echo.
echo ===================================
for /f %%a in ('type placeholder_list.txt ^| find /c /v ""') do set file_count=%%a
echo 共找到 !file_count! 个占位文件
echo ===================================
echo.

if !file_count! gtr 0 (
    set /p "confirm=是否删除这些占位文件？(Y/N): "
    if /i "!confirm!"=="Y" (
        echo.
        echo 正在删除占位文件...
        adb shell "su -c 'find "%target_dir%" -type f -size 0 -exec rm -f {} \; 2>/dev/null'"
        echo.
        echo 占位文件清空完成！
    ) else (
        echo.
        echo 已取消删除操作。
    )
) else (
    echo 没有找到占位文件。
)

del placeholder_list.txt
goto done

:all_groups_action
echo ===================================
echo        正在执行全部组别(zu1-zu6)
echo ===================================
echo.

for %%g in (%groups%) do (
    for /f "tokens=1,* delims==" %%a in ('set %%g_name') do (
        echo.
        echo ---------- 正在处理 %%b ----------
    )
    for %%i in (!%%g_ids!) do (
        echo 处理ID: %%i
        adb shell "su -c 'rm -rf "%target_dir%/%%i" && touch "%target_dir%/%%i" && chmod 0400 "%target_dir%/%%i"'"
    )
)

echo.
echo 全部组别处理完成！

:done
echo.
echo 按任意键返回主菜单...
pause > nul
goto main_menu
