@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion

:: 定义目标目录
set "target_dir=/data/data/com.tencent.tmgp.sgame/files/QtsVFSCache/packages/"

:: 检查adb是否可用
:check_adb
where adb >nul 2>&1
if %errorlevel% neq 0 (
    echo 未找到adb命令！注意ADB环境！
    pause
    exit /b 1
)

:: 主菜单循环
:main_menu
cls
echo ===================================
echo        设备连接状态检查
echo ===================================
echo.
adb devices | findstr "device$" > temp.txt
if errorlevel 1 (
    color 0C
    echo [状态] 未检测到设备
    echo.
    echo [提示] 请连接设备并授权USB调试
    echo.
    echo 按任意键重试...
    pause > nul
    del temp.txt
    goto main_menu
) else (
    color 0A
    echo [状态] 已检测到设备：
    echo.
    type temp.txt
    echo.
    del temp.txt
)

